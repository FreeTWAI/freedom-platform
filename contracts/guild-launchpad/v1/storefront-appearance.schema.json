        "accent_preset": {
          "type": "string",
          "enum": [
            "lime",
            "forest",
            "ocean",
            "indigo",
            "rose",
            "terracotta",
            "gold",
            "graphite"
          ]
        },
        "announcement": {
          "type": "string"
        },
        "featured_product_ids": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
