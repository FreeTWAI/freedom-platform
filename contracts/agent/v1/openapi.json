  "info": {
    "title": "自由工坊 Agent API",
    "version": "1.0.0",
    "description": "由 agent-allowlist.ts 產生；未列入的操作一律拒絕。"
  },
  "servers": [
    {
      "url": "https://freetwai.com/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "AgentBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "fw_agent_opaque"
      }
    }
  },
  "paths": {
    "/guilds/{guild}/tools/{tool}/token": {
      "post": {
        "operationId": "tools.identity",
        "summary": "取得工具專屬身分",
        "x-required-scope": "read",
        "security": [
          {
            "AgentBearer": []
          }
        ],
        "parameters": [
          {
            "name": "guild",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tool",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功；欄位沿用原會員 API。"
          },
          "401": {
            "description": "金鑰到期、撤銷或停用。"
          },
          "403": {
            "description": "權限不足或功能未開放。"
          },
          "409": {
            "description": "內容或狀態衝突，停止並詢問會員。"
          },
          "429": {
            "description": "已達限制，停止操作。"
          }
        }
      }
    },
