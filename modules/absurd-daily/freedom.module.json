{
  "format": "freedom.module/v1",
  "module_id": "absurd-daily",
  "owner_role": "community",
  "owned_paths": [
    "modules/absurd-daily/**",
    ".github/workflows/native-game-previews.yml",
    "apps/portal-web/src/games/**",
    "tests/runtime/absurd-daily.test.ts",
    "tests/runtime/kitchen-food-batch.test.ts",
    "tests/runtime/bounded-cpu-profile.test.ts",
    "tests/e2e/helpers/bounded-cpu-profile.ts",
    "tests/runtime/market-cooking.test.ts",
    "tests/e2e/absurd-daily.spec.ts",
    "docs/development/absurd-daily.md",
    "apps/portal-web/public/games/absurd-daily/**",
    "apps/platform-api/src/routes/game-uploads.ts",
    "migrations/203_member_game_quarantine.sql",
    "tests/runtime/game-quarantine.test.ts",
    "tests/runtime/game-quarantine-db.test.ts",
    "deploy/cloudflare/test/game-quarantine-schema.test.mjs"
  ],
  "public_exports": [
    "apps/portal-web/src/games/AbsurdDaily.tsx",
    "apps/portal-web/src/games/result-bridge.ts",
    "apps/portal-web/src/games/GameDraftInbox.tsx"
  ],
  "dependencies": [
    "shared",
    "asset-storage",
    "asset-lifecycle",
    "command-core",
    "resource-scopes",
    "scoped-commands"
  ],
  "contract_families": [],
  "client_profiles": [
    "member"
  ],
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "modules/absurd-daily/README.md",
    "modules/absurd-daily/GAME-QUARANTINE.md"
  ],
  "invariants": [
    "no-secrets-in-artifacts"
  ],
  "tests": [
    "runtime.full",
    "ui.default"
  ],
  "surfaces": [
    {
      "surface_id": "absurd-daily.game-page",
      "kind": "page",
      "entry": "apps/portal-web/src/games/AbsurdDaily.tsx",
      "operations": [
        "absurd-daily.game-page.view"
      ],
      "auth_profile": "public-anonymous-read"
    },
    {
      "surface_id": "absurd-daily.private-game-drafts",
      "kind": "http",
      "entry": "apps/platform-api/src/routes/game-uploads.ts",
      "operations": [
        "game.draft.create",
        "game.draft.read",
        "game.source.upload",
        "game.draft.withdraw"
      ],
      "auth_profile": "member-session"
    }
  ]
}
